# ============================================================
# VANA MasterDB Foundation — Environment Variables Template
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# PostgreSQL / PostGIS credentials
# Used by docker-compose.production.yml and init_db.py
# ----------------------------------------------------------
POSTGRES_USER=vana
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=vana_masterdb

# ----------------------------------------------------------
# VANA API
# Full database URL — constructed from the above by docker-compose.
# Override this directly if running the API outside of Docker.
# ----------------------------------------------------------
# VANA_DATABASE_URL=postgresql://vana:CHANGE_ME@localhost:5432/vana_masterdb

# Port the VANA API is exposed on the host
VANA_API_PORT=8013
