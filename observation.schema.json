{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhiv.local/vana/group3/observation.schema.json",
  "title": "VANA Group 3 Field Observation Schema V2.1",
  "description": "Group 3 V2.1 Field Observation contract supporting v0.6/v0.7 canonical MasterDB features.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "observation_id",
    "device_id",
    "timestamp",
    "latitude",
    "longitude",
    "measurement",
    "accuracy",
    "raw_artifact_reference",
    "processing_status",
    "provenance"
  ],

  "properties": {
    "observation_id": {
      "type": "string",
      "description": "Composite identity per Group 3 mission plan.",
      "pattern": "^[A-Z0-9]+-Z[0-9]{1,2}-F[0-9]{1,3}-[A-Z0-9]+-OBS[0-9]{3,}$",
      "examples": ["TC-Z03-F02-IMX500-OBS001", "TC-Z03-F02-LIDAR-OBS001"]
    },

    "survey_id":       { "type": "string", "description": "Survey. 'TC' = Thane Creek." },
    "zone_id":         { "type": "string", "pattern": "^Z[0-9]{1,2}$" },
    "flight_id":       { "type": "string", "pattern": "^F[0-9]{1,3}$" },
    "sensor_id":       { "type": "string" },
    "observation_seq": { "type": "string", "pattern": "^OBS[0-9]{3,}$" },

    "device_id": { "type": "string" },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "latitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    },
    "altitude_m": {
      "type": ["number", "null"]
    },
    "elevation": {
      "type": ["number", "null"]
    },

    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "altitude_m": { "type": ["number", "null"] },
        "gnss_status": { "type": ["string", "null"], "enum": ["FIX", "NO_FIX", "DEGRADED", "NOT_VERIFIED", null] },
        "position_accuracy_m": { "type": ["number", "null"] }
      }
    },

    "is_synthetic": {
      "type": ["boolean", "null"],
      "description": "Explicit observation-level synthetic flag."
    },

    "capture_method": {
      "type": ["string", "null"],
      "enum": ["aerial", "ground", "sensor", "site_evidence", null]
    },

    "observation_type": {
      "type": ["string", "null"],
      "description": "What was measured or capture method in V1.0."
    },

    "measurement": {
      "oneOf": [
        { "type": "number" },
        { "type": "string" },
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "value": { "type": ["number", "string", "null"] },
            "unit": { "type": ["string", "null"] },
            "artifact": { "type": ["string", "null"] }
          }
        }
      ]
    },

    "parameter": { "type": ["string", "null"] },
    "unit": { "type": ["string", "null"] },

    "accuracy": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "const": "NOT VERIFIED" },
        { "type": "string", "const": "NOT_VERIFIED" }
      ]
    },

    "calibration_status": {
      "type": "string",
      "enum": ["CALIBRATED", "NOT_CALIBRATED", "NOT VERIFIED", "NOT_VERIFIED"]
    },
    "calibration_state": {
      "type": "string",
      "enum": ["CALIBRATED", "NOT_CALIBRATED", "NOT VERIFIED", "NOT_VERIFIED"]
    },

    "quality_status": {
      "type": "string",
      "enum": ["RAW", "CAPTURED", "VALIDATED", "REJECTED", "UNCERTAIN", "INGESTED"]
    },
    "quality_state": {
      "type": "string",
      "enum": ["RAW", "CAPTURED", "VALIDATED", "REJECTED", "UNCERTAIN", "INGESTED"]
    },

    "gnss_status": {
      "type": ["string", "null"],
      "enum": ["FIX", "NO_FIX", "DEGRADED", "NOT_VERIFIED", null]
    },
    "position_accuracy_m": {
      "type": ["number", "null"]
    },

    "raw_artifact_reference": {
      "type": "object",
      "required": ["path", "artifact_type"],
      "additionalProperties": false,
      "properties": {
        "path":            { "type": "string" },
        "checksum_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "artifact_type":   { "type": "string", "enum": ["image", "video", "point_cloud", "sensor_reading", "flight_log", "other"] }
      }
    },

    "processing_status": { "type": "string" },

    "provenance": {
      "type": "object",
      "required": ["device_id", "mission_id", "captured_at", "raw_artifact"],
      "additionalProperties": false,
      "properties": {
        "device_id":    { "type": "string" },
        "operator":     { "type": ["string", "null"] },
        "mission_id":   { "type": "string" },
        "captured_at":  { "type": "string", "format": "date-time" },
        "raw_artifact": { "type": "string" },
        "qa_record":    { "type": ["string", "null"] }
      }
    },

    "tidal_state": {
      "type": ["string", "null"]
    },
    "trace_id": {
      "type": ["string", "null"]
    },
    "idempotency_key": {
      "type": ["string", "null"]
    }
  },

  "allOf": [
    {
      "$comment": "Location rule: missing lat or lon marks observation UNCERTAIN.",
      "if": {
        "anyOf": [
          { "properties": { "latitude":  { "type": "null" } }, "required": ["latitude"] },
          { "properties": { "longitude": { "type": "null" } }, "required": ["longitude"] }
        ]
      },
      "then": {
        "properties": {
          "quality_status": { "const": "UNCERTAIN" },
          "quality_state": { "const": "UNCERTAIN" }
        }
      }
    },
    {
      "$comment": "Unit rule: a numeric measurement requires a unit.",
      "if": { "properties": { "measurement": { "type": "number" } }, "required": ["measurement"] },
      "then": { "required": ["unit"], "properties": { "unit": { "type": "string" } } }
    }
  ]
}

